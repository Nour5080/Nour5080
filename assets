  <rect x="120" y="52" width="160" height="108" rx="10" fill="#0E0A09" stroke="#C8A27A" stroke-width="2.5"/>
  <circle cx="132" cy="63" r="3" fill="#E0604F"/><circle cx="142" cy="63" r="3" fill="#E8B04F"/><circle cx="152" cy="63" r="3" fill="#7FB37A"/>
  <rect class="code"    x="132" y="76"  width="54"  height="6" rx="3" fill="#C8A27A"/>
  <rect class="code c2" x="144" y="90"  width="96"  height="6" rx="3" fill="#8FB8DE"/>
  <rect class="code c3" x="144" y="104" width="70"  height="6" rx="3" fill="#E8D5C0" opacity=".8"/>
  <rect class="code c4" x="156" y="118" width="100" height="6" rx="3" fill="#7FB37A"/>
  <rect class="code c5" x="144" y="132" width="44"  height="6" rx="3" fill="#E0604F"/>
  <rect class="code c6" x="132" y="146" width="28"  height="6" rx="3" fill="#C8A27A"/>
  <rect x="192" y="160" width="16" height="22" fill="#5A3A2A"/>
  <rect x="168" y="180" width="64" height="6" rx="3" fill="#5A3A2A"/>
  <!-- desk -->
  <rect x="24" y="198" width="352" height="9" rx="4.5" fill="#6B4A36"/>
  <!-- mug -->
  <path class="steam"    d="M62 168 q-5 -7 0 -13 q5 -6 0 -12"/>
  <path class="steam s2" d="M72 168 q-5 -7 0 -13 q5 -6 0 -12"/>
  <rect x="54" y="172" width="26" height="26" rx="5" fill="#E8D5C0"/>
  <path d="M80 178 q10 0 10 8 q0 8 -10 8" fill="none" stroke="#E8D5C0" stroke-width="4"/>
  <!-- developer from behind -->
  <g class="head">
    <circle cx="200" cy="200" r="24" fill="#120C0A" stroke="#C8A27A" stroke-opacity=".45" stroke-width="2"/>
    <path d="M174 198 Q176 168 200 168 Q224 168 226 198" fill="none" stroke="#E0604F" stroke-width="5" stroke-linecap="round"/>
    <rect x="168" y="192" width="10" height="18" rx="4" fill="#E0604F"/><rect x="222" y="192" width="10" height="18" rx="4" fill="#E0604F"/>
  </g>
  <path d="M132 310 Q136 226 200 222 Q264 226 268 310 Z" fill="#120C0A" stroke="#C8A27A" stroke-opacity=".45" stroke-width="2"/>
