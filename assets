<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300" role="img" aria-label="A coffee cup cycling through espresso, latte, cappuccino and mocha">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#241815"/><stop offset="1" stop-color="#1A110E"/></linearGradient>
    <radialGradient id="glow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#C8A27A" stop-opacity=".2"/><stop offset="1" stop-color="#C8A27A" stop-opacity="0"/></radialGradient>
    <linearGradient id="cup" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#F6ECDF"/><stop offset="1" stop-color="#D8C3AA"/></linearGradient>
    <style>
      .steam { fill:none; stroke:#E8D5C0; stroke-width:4; stroke-linecap:round; opacity:0; animation: rise 3.2s ease-in-out infinite; }
      .s2{animation-delay:1.05s}.s3{animation-delay:2.1s}
      @keyframes rise { 0%{opacity:0;transform:translateY(8px)} 35%{opacity:.55} 100%{opacity:0;transform:translateY(-30px)} }
      .liquid { animation: brew 12s infinite; }
      @keyframes brew {
        0%,22%   { fill: #3A1F14; }
        25%,47%  { fill: #B9875A; }
        50%,72%  { fill: #E3C6A2; }
        75%,97%  { fill: #5C3020; }
        100%     { fill: #3A1F14; }
      }
      .art { opacity: 0; animation: show 12s infinite; }
      .name { font: 700 15px 'Segoe UI','Helvetica Neue',Arial,sans-serif; letter-spacing: 5px; fill: #F3E7D8; opacity: 0; animation: show 12s infinite; }
      .n2{animation-delay:3s}.n3{animation-delay:6s}.n4{animation-delay:9s}
      @keyframes show { 0%{opacity:0} 3%{opacity:1} 22%{opacity:1} 25%{opacity:0} 100%{opacity:0} }
      .label { font: 600 13px 'Cascadia Code',Consolas,monospace; letter-spacing: 3px; fill: #C8A27A; }
    </style>
  </defs>
  <rect width="400" height="300" rx="22" fill="url(#bg)"/>
  <rect x="1" y="1" width="398" height="298" rx="21" fill="none" stroke="#C8A27A" stroke-opacity=".25"/>
  <circle cx="200" cy="140" r="120" fill="url(#glow)"/>
  <!-- names -->
  <g text-anchor="middle">
    <text x="200" y="276" class="name">ESPRESSO</text>
    <text x="200" y="276" class="name n2">LATTE</text>
    <text x="200" y="276" class="name n3">CAPPUCCINO</text>
    <text x="200" y="276" class="name n4">MOCHA</text>
  </g>
  <g transform="translate(118 52)">
    <path class="steam"    d="M58 44 q-10 -14 0 -26 q10 -12 0 -24"/>
    <path class="steam s2" d="M82 44 q-10 -14 0 -26 q10 -12 0 -24"/>
    <path class="steam s3" d="M106 44 q-10 -14 0 -26 q10 -12 0 -24"/>
    <ellipse cx="82" cy="164" rx="96" ry="15" fill="#6B4A36"/>
    <ellipse cx="82" cy="159" rx="96" ry="13" fill="#E8D5C0"/>
    <path d="M144 76 q40 0 40 32 q0 30 -46 32" fill="none" stroke="#E8D5C0" stroke-width="12"/>
    <path d="M12 58 L152 58 L144 128 Q140 156 112 156 L52 156 Q24 156 20 128 Z" fill="url(#cup)"/>
    <ellipse cx="82" cy="58" rx="70" ry="13" fill="#4A2E22"/>
    <ellipse class="liquid" cx="82" cy="58" rx="61" ry="9"/>
    <!-- latte heart -->
    <path class="art n2" style="animation-name:show" d="M82 66 c-12 -9 -22 -1 -15 -8 c5 -5 11 -2 15 2 c4 -4 10 -7 15 -2 c7 7 -3 -1 -15 8z" fill="#F3E7D8"/>
    <!-- cappuccino foam dots -->
    <g class="art n3" fill="#FFF6EA"><circle cx="66" cy="57" r="4"/><circle cx="82" cy="55" r="5"/><circle cx="98" cy="58" r="4"/><circle cx="76" cy="61" r="3"/><circle cx="90" cy="61" r="3"/></g>
    <!-- mocha chocolate drizzle -->
    <path class="art n4" d="M46 57 q9 -6 18 0 t18 0 t18 0 t18 0" fill="none" stroke="#2A140C" stroke-width="2.5" stroke-linecap="round"/>
  </g>
  <text x="26" y="34" class="label">02 · COFFEE</text>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300" role="img" aria-label="A car doing donuts, seen from above, with tire marks and smoke">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#241815"/><stop offset="1" stop-color="#1A110E"/></linearGradient>
    <linearGradient id="body" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F0DCC2"/><stop offset="1" stop-color="#C39A6C"/></linearGradient>
    <filter id="soft"><feGaussianBlur stdDeviation="3"/></filter>
    <style>
      .spin { transform-origin: 200px 140px; animation: spin 2.4s linear infinite; }
      @keyframes spin { to { transform: rotate(-360deg); } }
      .marks { fill: none; stroke: #0A0605; stroke-width: 7; opacity: .55; }
      .marks2 { fill: none; stroke: #0A0605; stroke-width: 7; opacity: .35; }
      .puff { fill: #E8D5C0; opacity: 0; transform-box: fill-box; transform-origin: center; animation: puff 2.4s ease-out infinite; }
      @keyframes puff { 0%{opacity:.45;transform:scale(.5)} 60%{opacity:0;transform:scale(2.4)} 100%{opacity:0;transform:scale(2.4)} }
      .label { font: 600 13px 'Cascadia Code',Consolas,monospace; letter-spacing: 3px; fill: #C8A27A; }
    </style>
  </defs>
  <rect width="400" height="300" rx="22" fill="url(#bg)"/>
  <rect x="1" y="1" width="398" height="298" rx="21" fill="none" stroke="#C8A27A" stroke-opacity=".25"/>
  <g transform="translate(200 160) scale(.86) translate(-200 -140)">
  <!-- asphalt pad -->
  <circle cx="200" cy="140" r="118" fill="#14100E"/>
  <circle cx="200" cy="140" r="118" fill="none" stroke="#C8A27A" stroke-opacity=".15" stroke-dasharray="6 10"/>
  <!-- tire marks -->
  <circle class="marks"  cx="200" cy="140" r="84"/>
  <circle class="marks2" cx="200" cy="140" r="58"/>
  <circle class="marks2" cx="200" cy="140" r="90" opacity=".2"/>
  <!-- smoke trail: each puff fires as the car passes -->
  <g filter="url(#soft)">
    <circle class="puff" cx="284" cy="140" r="12" style="animation-delay:0.6s"/>
    <circle class="puff" cx="259" cy="199" r="12" style="animation-delay:0.3s"/>
    <circle class="puff" cx="200" cy="224" r="12" style="animation-delay:0.0s"/>
    <circle class="puff" cx="141" cy="199" r="12" style="animation-delay:2.1s"/>
    <circle class="puff" cx="116" cy="140" r="12" style="animation-delay:1.8s"/>
    <circle class="puff" cx="141" cy="81" r="12" style="animation-delay:1.5s"/>
    <circle class="puff" cx="200" cy="56" r="12" style="animation-delay:1.2s"/>
    <circle class="puff" cx="259" cy="81" r="12" style="animation-delay:0.9s"/>
  </g>
  <!-- car seen from above, nose pointing inward (drift angle) -->
  <g class="spin">
    <g transform="translate(200 210) rotate(-22)">
      <rect x="-50" y="-13" width="12" height="7" rx="2" fill="#0B0807"/>
      <rect x="-50" y="6"   width="12" height="7" rx="2" fill="#0B0807"/>
      <rect x="28"  y="-13" width="12" height="7" rx="2" fill="#0B0807" transform="rotate(-18 34 -9)"/>
      <rect x="28"  y="6"   width="12" height="7" rx="2" fill="#0B0807" transform="rotate(-18 34 10)"/>
      <rect x="-54" y="-20" width="104" height="40" rx="14" fill="url(#body)"/>
      <path d="M8 -15 Q26 -12 28 0 Q26 12 8 15 Z" fill="#1C120F"/>
      <rect x="-30" y="-14" width="30" height="28" rx="6" fill="#1C120F" opacity=".9"/>
      <rect x="-40" y="-14" width="6" height="28" rx="3" fill="#1C120F"/>
      <rect x="-56" y="-16" width="4" height="8" rx="2" fill="#E0604F"/>
      <rect x="-56" y="8"   width="4" height="8" rx="2" fill="#E0604F"/>
      <rect x="47"  y="-15" width="4" height="7" rx="2" fill="#FFE9B0"/>
      <rect x="47"  y="8"   width="4" height="7" rx="2" fill="#FFE9B0"/>
    </g>
  </g>
  </g>
  <text x="26" y="34" class="label">03 · DRIFT</text>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 230" width="1200" height="230" role="img" aria-label="Nour Mohamed, .NET Backend Developer">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1E1411"/><stop offset="1" stop-color="#33221C"/>
    </linearGradient>
    <radialGradient id="glow" cx=".5" cy=".45" r=".55">
      <stop offset="0" stop-color="#C8A27A" stop-opacity=".16"/><stop offset="1" stop-color="#C8A27A" stop-opacity="0"/>
    </radialGradient>
    <style>
      .name { font: 800 54px 'Segoe UI','Helvetica Neue',Arial,sans-serif; letter-spacing: 6px; fill: #F3E7D8; }
      .role { font: 600 18px 'Segoe UI','Helvetica Neue',Arial,sans-serif; letter-spacing: 8px; fill: #C8A27A; }
      .mono { font: 16px 'Cascadia Code',Consolas,'Courier New',monospace; fill: #E8D5C0; opacity: .9; }
      .cursor { animation: blink 1s steps(1) infinite; } @keyframes blink { 50% { opacity: 0; } }
      .bean { fill: #C8A27A; opacity: .07; animation: float 6s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: center; }
      .b2 { animation-delay: -2s; } .b3 { animation-delay: -4s; }
      @keyframes float { from { transform: translateY(-6px) rotate(-10deg); } to { transform: translateY(6px) rotate(10deg); } }
      .line { stroke: #C8A27A; stroke-width: 2; opacity: .5; stroke-dasharray: 160; animation: draw 3s ease-out forwards; }
      @keyframes draw { from { stroke-dashoffset: 160; } to { stroke-dashoffset: 0; } }
    </style>
  </defs>
  <rect width="1200" height="230" rx="24" fill="url(#bg)"/>
  <rect width="1200" height="230" rx="24" fill="url(#glow)"/>
  <g text-anchor="middle">
    <text x="600" y="102" class="name">NOUR MOHAMED</text>
    <line class="line" x1="520" y1="124" x2="680" y2="124"/>
    <text x="600" y="156" class="role">.NET BACKEND DEVELOPER</text>
    <text x="600" y="194" class="mono">&gt; brewing APIs, one cup at a time<tspan class="cursor" fill="#E0604F">_</tspan></text>
  </g>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300" role="img" aria-label="A developer writing code at night">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#241815"/><stop offset="1" stop-color="#1A110E"/></linearGradient>
    <radialGradient id="lamp" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#FFD9A0" stop-opacity=".22"/><stop offset="1" stop-color="#FFD9A0" stop-opacity="0"/></radialGradient>
    <radialGradient id="scr" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#8FB8DE" stop-opacity=".18"/><stop offset="1" stop-color="#8FB8DE" stop-opacity="0"/></radialGradient>
    <style>
      .code { transform-box: fill-box; transform-origin: left center; transform: scaleX(0); animation: type 7s steps(12) infinite; }
      .c2{animation-delay:.7s}.c3{animation-delay:1.4s}.c4{animation-delay:2.1s}.c5{animation-delay:2.8s}.c6{animation-delay:3.5s}
      @keyframes type { 0%{transform:scaleX(0)} 10%{transform:scaleX(1)} 88%{transform:scaleX(1);opacity:1} 100%{transform:scaleX(1);opacity:0} }
      .head { transform-box: fill-box; transform-origin: 50% 100%; animation: nod 2.4s ease-in-out infinite; }
      @keyframes nod { 0%,100%{transform:rotate(0)} 50%{transform:rotate(3deg)} }
      .steam { fill:none; stroke:#E8D5C0; stroke-width:2.5; stroke-linecap:round; opacity:0; animation: rise 3s ease-in-out infinite; }
      .s2{animation-delay:1.5s}
      @keyframes rise { 0%{opacity:0;transform:translateY(4px)} 40%{opacity:.5} 100%{opacity:0;transform:translateY(-14px)} }
      .label { font: 600 13px 'Cascadia Code',Consolas,monospace; letter-spacing: 3px; fill: #C8A27A; }
      .glowpulse { animation: pulse 4s ease-in-out infinite; } @keyframes pulse { 50% { opacity: .6; } }
    </style>
  </defs>
  <clipPath id="card"><rect width="400" height="300" rx="22"/></clipPath>
  <rect width="400" height="300" rx="22" fill="url(#bg)"/>
  <g clip-path="url(#card)">
  <rect x="1" y="1" width="398" height="298" rx="21" fill="none" stroke="#C8A27A" stroke-opacity=".25"/>
  <!-- window with moon -->
  <rect x="34" y="52" width="74" height="60" rx="8" fill="#16100D" stroke="#5A3A2A" stroke-width="3"/>
  <line x1="71" y1="52" x2="71" y2="112" stroke="#5A3A2A" stroke-width="3"/>
  <circle cx="92" cy="72" r="9" fill="#F3E7D8" opacity=".8"/>
  <circle cx="96" cy="69" r="8" fill="#16100D"/>
  <!-- lamp -->
  <circle class="glowpulse" cx="320" cy="130" r="80" fill="url(#lamp)"/>
  <path d="M318 196 L318 150 L340 120" fill="none" stroke="#8A6648" stroke-width="4" stroke-linecap="round"/>
  <path d="M326 108 L358 114 L346 136 Z" fill="#C8A27A"/>
  <rect x="304" y="194" width="30" height="6" rx="3" fill="#8A6648"/>
  <!-- monitor -->
